{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Live Game Translator: chạy từ source",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/electron-vite/bin/electron-vite.js",
      "args": ["dev", "--watch", "--sourcemap"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/main/**/*.js", "${workspaceFolder}/out/preload/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
      "env": {
        "ELECTRON_RUN_AS_NODE": null
      }
    }
  ]
}
